# WordPress default pages
/en/sample-page/  /en/  301
/en/portfolio/  /en/  301
/en/hello-world/  /en/blog/  301

# Old WordPress URLs without /en/ prefix
/contact/  /en/contact/  301
/tango-classes/  /en/tango-classes/  301
/tango-classes/woluwe/  /en/tango-classes/woluwe/  301

# Old blog URLs without the /en/ prefix. Until 404.html existed these returned
# HTTP 200 with the root language-redirect page, so they looked live to search
# engines; now they would 404. Every old slug still matches an EN post, so send
# them to their real home instead of dropping the inbound links.
/blog/  /en/blog/  301
/blog/*  /en/blog/:splat  301

# WordPress wp-content assets — 404 is correct, no redirect needed
# /wp-content/* paths are old media/theme assets that no longer exist

# Note: Query-string redirects (/?p=1, /?page_id=2, /?p=1053)
# are not supported by Cloudflare Pages _redirects file.
# These will naturally stop being crawled over time.
