# Static assets are versioned in the URL (?v=3.8), so they can be cached
# indefinitely — a change ships under a new query string. Default was 4h
# with must-revalidate, which cost a round trip per asset on every repeat visit.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
